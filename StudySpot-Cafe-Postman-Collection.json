    {
      "name": "1. Carrels Endpoints",
      "item": [
        {
          "name": "GET All Carrels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrels",
              "host": ["{{baseUrl}}"],
              "path": ["carrels"]
            },
            "description": "Retrieves the full list of study carrels in the cafe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Top 3 Carrels (Member 4 Twist)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrels/top",
              "host": ["{{baseUrl}}"],
              "path": ["carrels", "top"]
            },
            "description": "Member 4 Special Endpoint: Returns up to 3 carrels that appear in the highest number of bookings, sorted by booking_count DESC, then carrel name ASC. Uses INNER JOIN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of max 3 items\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    pm.expect(json.length).to.be.at.most(3);",
                  "});",
                  "pm.test(\"Items contain required fields and booking_count\", function () {",
                  "    var json = pm.response.json();",
                  "    if (json.length > 0) {",
                  "        pm.expect(json[0]).to.have.property(\"id\");",
                  "        pm.expect(json[0]).to.have.property(\"name\");",
                  "        pm.expect(json[0]).to.have.property(\"zone\");",
                  "        pm.expect(json[0]).to.have.property(\"booking_count\");",
                  "        pm.expect(typeof json[0].booking_count).to.eql(\"number\");",
                  "    }",
                  "});",
                  "pm.test(\"Results are ordered by booking_count descending\", function () {",
                  "    var json = pm.response.json();",
                  "    for (var i = 0; i < json.length - 1; i++) {",
                  "        pm.expect(json[i].booking_count).to.be.at.least(json[i + 1].booking_count);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Filter Carrels by Zone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrels?zone=Silent Study",
              "host": ["{{baseUrl}}"],
              "path": ["carrels"],
              "query": [
                {
                  "key": "zone",
                  "value": "Silent Study"
                }
              ]
            },
            "description": "Filters carrels by zone (Member 3 feature)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Filtered results match requested zone\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    json.forEach(function (c) {",
                  "        pm.expect(c.zone).to.eql(\"Silent Study\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
