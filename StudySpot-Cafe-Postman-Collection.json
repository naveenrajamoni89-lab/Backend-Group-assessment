                  "    pm.expect(json.carrel.name).to.eql(\"Zen Station Z9\");",
                  "    pm.expect(json.carrel.zone).to.eql(\"Deep Focus\");",
                  "    pm.collectionVariables.set(\"createdCarrelId\", json.carrel.id);",
