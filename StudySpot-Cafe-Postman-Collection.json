      "name": "0. Health & Welcome",
      "item": [
        {
          "name": "GET Root Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Checks server health, team member responsibilities, and registered endpoint routes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has correct welcome message\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"Server active\");",
                  "    pm.expect(json.team).to.be.an(\"object\");",
                  "    pm.expect(json.team.member4).to.include(\"Top Carrels\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Unknown Route (404 Handling)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/unknown-nonexistent-route",
              "host": ["{{baseUrl}}"],
              "path": ["unknown-nonexistent-route"]
